module confined-ksplice 1.5;

require {
    type http_port_t;
    type modules_object_t;
    type init_t;
    type kmod_t;
    type var_t;
    type var_run_t;
    class tcp_socket name_connect;
    class dir { add_name remove_name rename };
    class file { create ioctl lock open read setattr unlink write };
}

allow init_t http_port_t:tcp_socket name_connect;
allow init_t var_t:file { create ioctl open read write };
allow init_t modules_object_t:dir { add_name remove_name rename };
allow init_t modules_object_t:file { create setattr unlink write };

allow kmod_t var_run_t:file { lock open write };
