module confined-ksplice 1.3;

require {
    type http_port_t;
    type modules_object_t;
    type init_t;
    type kmod_t;
    type var_t;
    type var_run_t;
    class tcp_socket name_connect;
    class dir add_name;
    class file { create ioctl lock open read setattr write };
}

allow init_t http_port_t:tcp_socket name_connect;
allow init_t var_t:file { create ioctl open read write };
allow init_t modules_object_t:dir add_name;
allow init_t modules_object_t:file { create setattr write };

allow kmod_t var_run_t:file { lock open write };
