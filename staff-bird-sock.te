module staff-bird-sock 1.3;

require {
    type bird_var_run_t;
    type bird_t;
    type staff_t;
    type sysadm_t;
    type sysadm_sudo_t;
    class sock_file write;
    class unix_stream_socket connectto;
}

allow { staff_t sysadm_t sysadm_sudo_t } bird_t:unix_stream_socket connectto;
allow { staff_t sysadm_t sysadm_sudo_t } bird_var_run_t:sock_file write;
