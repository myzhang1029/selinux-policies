module ssh-notify-login 1.4;

require {
    type sshd_session_t;
    type hostname_t;
    type user_mail_t;
    type hostname_exec_t;
    type sendmail_exec_t;
    type smtp_port_t;
    type cert_t;
    class tcp_socket { name_connect };
    class dir write;
    class file { open execute execute_no_trans map read };
    class fifo_file read;
}

allow sshd_session_t hostname_exec_t:file { open execute read };
dontaudit sshd_session_t hostname_exec_t:file { execute_no_trans map };
allow sshd_session_t sendmail_exec_t:file { open execute read };
dontaudit sshd_session_t sendmail_exec_t:file { execute_no_trans map };
allow sshd_session_t smtp_port_t:tcp_socket name_connect;
dontaudit hostname_t sshd_session_t:fifo_file read;
dontaudit user_mail_t cert_t:dir write;
