module postfix-opendkim 1.2;

require {
    type var_run_t, unconfined_service_t;
    type postfix_cleanup_t, postfix_smtpd_t;
    class sock_file write;
    class unix_stream_socket connectto;
}

allow { postfix_cleanup_t postfix_smtpd_t } var_run_t:sock_file write;
allow { postfix_cleanup_t postfix_smtpd_t } unconfined_service_t:unix_stream_socket connectto;
