module systemd-supplement 1.4;

require {
    type systemd_journal_init_t;
    type systemd_tmpfiles_t;
    type systemd_generator_t;
    type syslogd_t;
    type bin_t;
    type var_log_t;
    type etc_runtime_t;
    type systemd_journal_t;
    type swapfile_t;
    type tmpfs_t;
    class dir { getattr search watch };
    class file { getattr open read map };
    class lnk_file { getattr open read relabelfrom relabelto };
    class process signal;
}

# systemd_journal_init_t
allow systemd_journal_init_t var_log_t:dir search;
allow systemd_journal_init_t etc_runtime_t:file { open read };
allow systemd_journal_init_t systemd_journal_t:dir watch;
allow systemd_journal_init_t systemd_journal_t:file map;
allow systemd_journal_init_t self:process signal;

# syslogd_t
allow syslogd_t tmpfs_t:dir search;

# systemd_tmpfiles_t
allow systemd_tmpfiles_t bin_t:lnk_file { getattr open read relabelfrom relabelto };

# systemd_generator_t
allow systemd_generator_t swapfile_t:dir getattr;
allow systemd_generator_t swapfile_t:file getattr;
