
## <summary>policy for zerotier_one</summary>

########################################
## <summary>
##	Execute zerotier_one_exec_t in the zerotier_one domain.
## </summary>
## <param name="domain">
## <summary>
##	Domain allowed to transition.
## </summary>
## </param>
#
interface(`zerotier_one_domtrans',`
	gen_require(`
		type zerotier_one_t, zerotier_one_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, zerotier_one_exec_t, zerotier_one_t)
')

######################################
## <summary>
##	Execute zerotier_one in the caller domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`zerotier_one_exec',`
	gen_require(`
		type zerotier_one_exec_t;
	')

	corecmd_search_bin($1)
	can_exec($1, zerotier_one_exec_t)
')

########################################
## <summary>
##	Search zerotier_one lib directories.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`zerotier_one_search_lib',`
	gen_require(`
		type zerotier_one_var_lib_t;
	')

	allow $1 zerotier_one_var_lib_t:dir search_dir_perms;
	files_search_var_lib($1)
')

########################################
## <summary>
##	Read zerotier_one lib files.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`zerotier_one_read_lib_files',`
	gen_require(`
		type zerotier_one_var_lib_t;
	')

	files_search_var_lib($1)
	read_files_pattern($1, zerotier_one_var_lib_t, zerotier_one_var_lib_t)
')

########################################
## <summary>
##	Manage zerotier_one lib files.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`zerotier_one_manage_lib_files',`
	gen_require(`
		type zerotier_one_var_lib_t;
	')

	files_search_var_lib($1)
	manage_files_pattern($1, zerotier_one_var_lib_t, zerotier_one_var_lib_t)
')

########################################
## <summary>
##	Manage zerotier_one lib directories.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`zerotier_one_manage_lib_dirs',`
	gen_require(`
		type zerotier_one_var_lib_t;
	')

	files_search_var_lib($1)
	manage_dirs_pattern($1, zerotier_one_var_lib_t, zerotier_one_var_lib_t)
')

########################################
## <summary>
##	Execute zerotier_one server in the zerotier_one domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed to transition.
##	</summary>
## </param>
#
interface(`zerotier_one_systemctl',`
	gen_require(`
		type zerotier_one_t;
		type zerotier_one_unit_file_t;
	')

	systemd_exec_systemctl($1)
        systemd_read_fifo_file_passwd_run($1)
	allow $1 zerotier_one_unit_file_t:file read_file_perms;
	allow $1 zerotier_one_unit_file_t:service manage_service_perms;

	ps_process_pattern($1, zerotier_one_t)
')


########################################
## <summary>
##	All of the rules required to administrate
##	an zerotier_one environment
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access.
##	</summary>
## </param>
## <rolecap/>
#
interface(`zerotier_one_admin',`
	gen_require(`
		type zerotier_one_t;
		type zerotier_one_var_lib_t;
	type zerotier_one_unit_file_t;
	')

	allow $1 zerotier_one_t:process { signal_perms };
	ps_process_pattern($1, zerotier_one_t)

    tunable_policy(`deny_ptrace',`',`
        allow $1 zerotier_one_t:process ptrace;
    ')

	files_search_var_lib($1)
	admin_pattern($1, zerotier_one_var_lib_t)

	zerotier_one_systemctl($1)
	admin_pattern($1, zerotier_one_unit_file_t)
	allow $1 zerotier_one_unit_file_t:service all_service_perms;
	optional_policy(`
		systemd_passwd_agent_exec($1)
		systemd_read_fifo_file_passwd_run($1)
	')
')
