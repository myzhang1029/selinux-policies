
## <summary>policy for dufs</summary>

########################################
## <summary>
##	Execute dufs_exec_t in the dufs domain.
## </summary>
## <param name="domain">
## <summary>
##	Domain allowed to transition.
## </summary>
## </param>
#
interface(`dufs_domtrans',`
	gen_require(`
		type dufs_t, dufs_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, dufs_exec_t, dufs_t)
')

######################################
## <summary>
##	Execute dufs in the caller domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`dufs_exec',`
	gen_require(`
		type dufs_exec_t;
	')

	corecmd_search_bin($1)
	can_exec($1, dufs_exec_t)
')
########################################
## <summary>
##	Read dufs PID files.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`dufs_read_pid_files',`
	gen_require(`
		type dufs_var_run_t;
	')

	files_search_pids($1)
	read_files_pattern($1, dufs_var_run_t, dufs_var_run_t)
')


########################################
## <summary>
##	All of the rules required to administrate
##	an dufs environment
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access.
##	</summary>
## </param>
## <rolecap/>
#
interface(`dufs_admin',`
	gen_require(`
		type dufs_t;
		type dufs_var_run_t;
	')

	allow $1 dufs_t:process { signal_perms };
	ps_process_pattern($1, dufs_t)

    tunable_policy(`deny_ptrace',`',`
        allow $1 dufs_t:process ptrace;
    ')

	files_search_pids($1)
	admin_pattern($1, dufs_var_run_t)
	optional_policy(`
		systemd_passwd_agent_exec($1)
		systemd_read_fifo_file_passwd_run($1)
	')
')
