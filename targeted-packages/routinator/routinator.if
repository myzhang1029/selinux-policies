
## <summary>policy for routinator</summary>

########################################
## <summary>
##	Execute routinator_exec_t in the routinator domain.
## </summary>
## <param name="domain">
## <summary>
##	Domain allowed to transition.
## </summary>
## </param>
#
interface(`routinator_domtrans',`
	gen_require(`
		type routinator_t, routinator_exec_t;
	')

	corecmd_search_bin($1)
	domtrans_pattern($1, routinator_exec_t, routinator_t)
')

######################################
## <summary>
##	Execute routinator in the caller domain.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`routinator_exec',`
	gen_require(`
		type routinator_exec_t;
	')

	corecmd_search_bin($1)
	can_exec($1, routinator_exec_t)
')

########################################
## <summary>
##	Search routinator lib directories.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`routinator_search_lib',`
	gen_require(`
		type routinator_var_lib_t;
	')

	allow $1 routinator_var_lib_t:dir search_dir_perms;
	files_search_var_lib($1)
')

########################################
## <summary>
##	Read routinator lib files.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`routinator_read_lib_files',`
	gen_require(`
		type routinator_var_lib_t;
	')

	files_search_var_lib($1)
	read_files_pattern($1, routinator_var_lib_t, routinator_var_lib_t)
')

########################################
## <summary>
##	Manage routinator lib files.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`routinator_manage_lib_files',`
	gen_require(`
		type routinator_var_lib_t;
	')

	files_search_var_lib($1)
	manage_files_pattern($1, routinator_var_lib_t, routinator_var_lib_t)
')

########################################
## <summary>
##	Manage routinator lib directories.
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
#
interface(`routinator_manage_lib_dirs',`
	gen_require(`
		type routinator_var_lib_t;
	')

	files_search_var_lib($1)
	manage_dirs_pattern($1, routinator_var_lib_t, routinator_var_lib_t)
')


########################################
## <summary>
##	All of the rules required to administrate
##	an routinator environment
## </summary>
## <param name="domain">
##	<summary>
##	Domain allowed access.
##	</summary>
## </param>
## <param name="role">
##	<summary>
##	Role allowed access.
##	</summary>
## </param>
## <rolecap/>
#
interface(`routinator_admin',`
	gen_require(`
		type routinator_t;
		type routinator_var_lib_t;
	')

	allow $1 routinator_t:process { signal_perms };
	ps_process_pattern($1, routinator_t)

    tunable_policy(`deny_ptrace',`',`
        allow $1 routinator_t:process ptrace;
    ')

	files_search_var_lib($1)
	admin_pattern($1, routinator_var_lib_t)
	optional_policy(`
		systemd_passwd_agent_exec($1)
		systemd_read_fifo_file_passwd_run($1)
	')
')
